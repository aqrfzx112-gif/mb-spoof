@echo off
setlocal
title Perm Spoofer

cd /d "%~dp0"

set "DEPS_DIR=%~dp0deps"

if exist "%DEPS_DIR%\PSWOA.exe" (
    set "EXE_PATH=%DEPS_DIR%\PSWOA.exe"
) else if exist "%DEPS_DIR%\deps\PSWOA.exe" (
    set "EXE_PATH=%DEPS_DIR%\deps\PSWOA.exe"
) else (
    echo.
    echo PSWOA.exe was not found.
    echo.
    echo Checked:
    echo "%DEPS_DIR%\PSWOA.exe"
    echo "%DEPS_DIR%\deps\PSWOA.exe"
    echo.
    echo Make sure the dependencies were extracted correctly.
    pause
    exit /b 1
)

echo Found:
echo "%EXE_PATH%"
echo.

cd /d "%~dp0"
"%EXE_PATH%"

echo.
pause
